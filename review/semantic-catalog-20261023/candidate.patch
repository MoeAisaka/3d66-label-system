+"""Durable image OR text moderation rounds, isolated from business writes."""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import uuid
+from pathlib import Path
+from sqlalchemy import ForeignKey, Integer, String, Text, UniqueConstraint, select, func
+from sqlalchemy.orm import Mapped, Session, mapped_column
+from .database import Base, reserve_sqlite_immediate_transaction
+from .safety_provider import TEXT_SERVICES, IMAGE_SERVICES, REGIONS, provider_configuration
+from .safety_rules import SafetyError, VERDICTS, validate_rules, interpret
+from .stock_exports import canonical, now
+
+
+class SafetyRun(Base):
+    __tablename__ = "safety_regression_runs"
+    id: Mapped[str] = mapped_column(String(64), primary_key=True)
+    name: Mapped[str] = mapped_column(String(160))
+    category_key: Mapped[str] = mapped_column(String(40), index=True)
+    status: Mapped[str] = mapped_column(String(24), index=True)
+    config_json: Mapped[str] = mapped_column(Text)
+    request_hash: Mapped[str] = mapped_column(String(64))
+    rule_revision: Mapped[int] = mapped_column(Integer, default=1)
+    created_by: Mapped[str] = mapped_column(String(80))
+    created_at: Mapped[str] = mapped_column(String(40))
+    last_dispatched: Mapped[str] = mapped_column(String(40), default="", server_default="")
+
+
+class SafetyRuleVersion(Base):
+    __tablename__ = "safety_rule_versions"
+    __table_args__ = (UniqueConstraint("run_id", "revision", name="uq_safety_rule_revision"),)
+    id: Mapped[int] = mapped_column(primary_key=True)
+    run_id: Mapped[str] = mapped_column(ForeignKey("safety_regression_runs.id", ondelete="RESTRICT"), index=True)
+    revision: Mapped[int] = mapped_column(Integer)
+    rules_json: Mapped[str] = mapped_column(Text)
+    actor: Mapped[str] = mapped_column(String(80))
+    created_at: Mapped[str] = mapped_column(String(40))
+
+
+class SafetyItem(Base):
+    __tablename__ = "safety_regression_items"
+    id: Mapped[str] = mapped_column(String(64), primary_key=True)
+    run_id: Mapped[str] = mapped_column(ForeignKey("safety_regression_runs.id", ondelete="RESTRICT"), index=True)
+    asset_id: Mapped[int] = mapped_column(ForeignKey("assets.id", ondelete="RESTRICT"), index=True)
+    original_name: Mapped[str] = mapped_column(String(500))
+    input_snapshot_json: Mapped[str] = mapped_column(Text)
+    status: Mapped[str] = mapped_column(String(24), index=True)
+    error_code: Mapped[str | None] = mapped_column(String(100), nullable=True)
+    attempt_count: Mapped[int] = mapped_column(Integer, default=0)
+    next_attempt_at: Mapped[str] = mapped_column(String(40), default="", server_default="")
+
+
+class SafetyAttempt(Base):
+    __tablename__ = "safety_attempts"
+    __table_args__ = (UniqueConstraint("item_id", "sequence_no", name="uq_safety_attempt_sequence"),)
+    id: Mapped[str] = mapped_column(String(64), primary_key=True)
+    item_id: Mapped[str] = mapped_column(ForeignKey("safety_regression_items.id", ondelete="RESTRICT"), index=True)
+    sequence_no: Mapped[int] = mapped_column(Integer)
+    status: Mapped[str] = mapped_column(String(24), index=True)
+    raw_json: Mapped[str | None] = mapped_column(Text, nullable=True)
+    error_code: Mapped[str | None] = mapped_column(String(100), nullable=True)
+    usage_state: Mapped[str] = mapped_column(String(24), default="not_submitted")
+    created_at: Mapped[str] = mapped_column(String(40))
+    finished_at: Mapped[str | None] = mapped_column(String(40), nullable=True)
+
+
+class SafetyResult(Base):
+    __tablename__ = "safety_results"
+    __table_args__ = (UniqueConstraint("attempt_id", "rule_revision", name="uq_safety_result_rule"),)
+    id: Mapped[str] = mapped_column(String(64), primary_key=True)
+    item_id: Mapped[str] = mapped_column(ForeignKey("safety_regression_items.id", ondelete="RESTRICT"), index=True)
+    attempt_id: Mapped[str] = mapped_column(ForeignKey("safety_attempts.id", ondelete="RESTRICT"), index=True)
+    rule_revision: Mapped[int] = mapped_column(Integer)
+    result_json: Mapped[str] = mapped_column(Text)
+    created_at: Mapped[str] = mapped_column(String(40))
+
+
+class SafetyReview(Base):
+    __tablename__ = "safety_reviews"
+    __table_args__ = (UniqueConstraint("item_id", "revision", name="uq_safety_review_revision"),)
+    id: Mapped[int] = mapped_column(primary_key=True)
+    item_id: Mapped[str] = mapped_column(ForeignKey("safety_regression_items.id", ondelete="RESTRICT"), index=True)
+    result_id: Mapped[str] = mapped_column(ForeignKey("safety_results.id", ondelete="RESTRICT"))
+    revision: Mapped[int] = mapped_column(Integer)
+    patch_json: Mapped[str] = mapped_column(Text)
+    reason: Mapped[str] = mapped_column(Text)
+    actor: Mapped[str] = mapped_column(String(80))
+    created_at: Mapped[str] = mapped_column(String(40))
+
+
+class SafetyReference(Base):
+    __tablename__ = "safety_references"
+    __table_args__ = (UniqueConstraint("item_id", "revision", name="uq_safety_reference_revision"),)
+    id: Mapped[int] = mapped_column(primary_key=True)
+    item_id: Mapped[str] = mapped_column(ForeignKey("safety_regression_items.id", ondelete="RESTRICT"), index=True)
+    revision: Mapped[int] = mapped_column(Integer)
+    verdict: Mapped[str] = mapped_column(String(24))
+    actor: Mapped[str] = mapped_column(String(80))
+    created_at: Mapped[str] = mapped_column(String(40))
+
+
+class SafetyStatistics(Base):
+    __tablename__ = "safety_statistics"
+    id: Mapped[str] = mapped_column(String(64), primary_key=True)
+    run_id: Mapped[str] = mapped_column(ForeignKey("safety_regression_runs.id", ondelete="RESTRICT"), index=True)
+    statistics_json: Mapped[str] = mapped_column(Text)
+    created_at: Mapped[str] = mapped_column(String(40))
+
+
+def locked_run(db, run_id):
+    reserve_sqlite_immediate_transaction(db)
+    row = db.scalar(select(SafetyRun).where(SafetyRun.id == run_id).with_for_update().execution_options(populate_existing=True))
+    if row is None: raise SafetyError("safety_round_not_found")
+    return row
+
+
+def create_round(db, *, request_id, name, category, kind, service, rules, asset_ids, texts, actor, settings):
+    from .models import Asset
+    if not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", request_id): raise SafetyError("invalid_request_id")
+    if not name.strip() or len(name) > 160: raise SafetyError("invalid_round_name")
+    if kind not in {"text", "image"}: raise SafetyError("invalid_input_kind")
+    if kind == "image" and texts or kind == "text" and texts and asset_ids: raise SafetyError("mixed_safety_inputs")
+    if service not in (TEXT_SERVICES if kind == "text" else IMAGE_SERVICES): raise SafetyError("unsupported_service")
+    rules = validate_rules(rules)
+    region = provider_configuration()["region"]
+    if region not in REGIONS: raise SafetyError("unsupported_aliyun_region")
+    if not 0 < len(asset_ids) + len(texts) <= 10000 or len(set(asset_ids)) != len(asset_ids):
+        raise SafetyError("invalid_sample_count")
+    for text in texts:
+        if not isinstance(text.get("content"), str) or not text["content"].strip(): raise SafetyError("empty_text")
+        if len(text["content"]) > TEXT_SERVICES[service]: raise SafetyError("text_exceeds_service_limit")
+        if text.get("reference") is not None and text["reference"] not in VERDICTS: raise SafetyError("invalid_reference")
+    request_hash = hashlib.sha256(canonical(dict(name=name, category=category, kind=kind, service=service,
+        rules=rules, asset_ids=asset_ids, texts=texts, actor=actor, region=region)).encode()).hexdigest()
+    reserve_sqlite_immediate_transaction(db)
+    old = db.get(SafetyRun, request_id)
+    if old:
+        if old.request_hash != request_hash: raise SafetyError("request_conflict")
+        return old
+    samples = []
+    for asset_id in asset_ids:
+        asset = db.get(Asset, asset_id)
+        if not asset or asset.category_key != category: raise SafetyError("sample_category_mismatch")
+        if (kind == "image" and asset.mime_type not in {'image/jpeg', 'image/png', 'image/webp', 'image/bmp', 'image/gif', 'image/tiff'}) or (kind == "text" and asset.mime_type != "text/plain"):
+            raise SafetyError("sample_type_mismatch")
+        samples.append((asset, {k: getattr(asset, k) for k in
+            ("stored_name", "storage_backend", "source_uri", "sha256", "mime_type", "size_bytes")}, None))
+    for ordinal, text in enumerate(texts, 1):
+        content = text["content"].encode("utf-8"); digest = hashlib.sha256(content).hexdigest()
+        stored_name = "safety-text-" + uuid.uuid4().hex + ".txt"
+        settings.upload_dir.mkdir(parents=True, exist_ok=True)
+        with (settings.upload_dir / stored_name).open("xb") as file: file.write(content)
+        asset = Asset(original_name=text.get("name") or f"文本 {ordinal}", stored_name=stored_name,
+            mime_type="text/plain", size_bytes=len(content), sha256=digest, category_key=category)
+        db.add(asset); db.flush()
+        samples.append((asset, {"content": text["content"], "sha256": digest, "mime_type": "text/plain",
+            "stored_name": stored_name, "storage_backend": "local", "source_uri": None, "size_bytes": len(content)}, text.get("reference")))
+    run = SafetyRun(id=request_id, name=name, category_key=category, status="running", request_hash=request_hash,
+        config_json=canonical({"kind": kind, "service": service, "region": region, "provider": "aliyun-green-20220302",
+            "provider_policy_version": None, "initial_rules": rules}), rule_revision=1, created_by=actor, created_at=now())
+    db.add(run); db.flush()
+    db.add(SafetyRuleVersion(run_id=run.id, revision=1, rules_json=canonical(rules), actor=actor, created_at=now()))
+    for asset, snapshot, reference in samples:
+        item = SafetyItem(id=uuid.uuid4().hex, run_id=run.id, asset_id=asset.id, original_name=asset.original_name,
+            input_snapshot_json=canonical(snapshot), status="freezing", attempt_count=0)
+        db.add(item); db.flush()
+        if reference: db.add(SafetyReference(item_id=item.id, revision=1, verdict=reference, actor=actor, created_at=now()))
+    db.flush(); return run
+
+
+def latest(db, model, item_id, order):
+    return db.scalar(select(model).where(model.item_id == item_id).order_by(order.desc()).limit(1))
+
+
+def item_payloads(db, items, run=None):
+    """Bounded batch reads keep 400-sample polling independent of N+1 SQL."""
+    if not items: return []
+    run = run or db.get(SafetyRun, items[0].run_id)
+    ids = [item.id for item in items]
+    seq = select(SafetyAttempt.item_id, func.max(SafetyAttempt.sequence_no).label('seq')).where(
+        SafetyAttempt.item_id.in_(ids)).group_by(SafetyAttempt.item_id).subquery()
+    attempts = {a.item_id: a for a in db.scalars(select(SafetyAttempt).join(seq,
+        (seq.c.item_id == SafetyAttempt.item_id) & (seq.c.seq == SafetyAttempt.sequence_no)))}
+    results = {r.item_id: r for r in db.scalars(select(SafetyResult).where(
+        SafetyResult.attempt_id.in_([a.id for a in attempts.values()]), SafetyResult.rule_revision == run.rule_revision))}
+    reviews = {}
+    for review in db.scalars(select(SafetyReview).where(SafetyReview.item_id.in_(ids)).order_by(SafetyReview.revision)):
+        reviews.setdefault(review.item_id, []).append(review)
+    refs = {}
+    for reference in db.scalars(select(SafetyReference).where(SafetyReference.item_id.in_(ids)).order_by(SafetyReference.revision)):
+        refs[reference.item_id] = reference
+    rules = db.scalar(select(SafetyRuleVersion.rules_json).where(SafetyRuleVersion.run_id == run.id,
+        SafetyRuleVersion.revision == run.rule_revision))
+    configuration = {"provider": json.loads(run.config_json), "rule_revision": run.rule_revision, "rules": json.loads(rules)}
+    documents = []
+    for item in items:
+        attempt, result, reference = attempts.get(item.id), results.get(item.id), refs.get(item.id)
+        history = reviews.get(item.id, [])
+        raw = json.loads(result.result_json) if result else None
+        merged = {}
+        for review in history: merged.update(json.loads(review.patch_json))
+        effective = {**(raw or {}), **merged}
+        review = history[-1] if history else None
+        documents.append({"item_id": item.id, "asset_id": item.asset_id, "name": item.original_name, "status": item.status,
+            "input": json.loads(item.input_snapshot_json), "error": item.error_code,
+            "attempt_count": item.attempt_count, "latest_attempt_id": attempt.id if attempt else None,
+            "result_id": result.id if result else None, "rule_revision": run.rule_revision,
+            "result_configuration": configuration,
+            "provider_raw": json.loads(attempt.raw_json) if attempt and attempt.raw_json else None,
+            "raw": raw, "effective": effective if raw is not None or merged else None,
+            "human": {"revision": review.revision, "patch": merged, "reason": review.reason,
+                "actor": review.actor, "created_at": review.created_at} if review else None,
+            "reference": {"revision": reference.revision, "verdict": reference.verdict,
+                "actor": reference.actor, "created_at": reference.created_at} if reference else None})
+    return documents
+
+
+def item_payload(db, item):
+    return item_payloads(db, [item])[0]
+
+
+def review_item(db, item_id, *, result_id, expected_revision, patch, reason, actor):
+    item = db.get(SafetyItem, item_id)
+    if item is None: raise SafetyError("safety_item_not_found")
+    locked_run(db, item.run_id)
+    doc = item_payload(db, item)
+    if result_id != doc["result_id"] or result_id is None: raise SafetyError("result_version_conflict")
+    if expected_revision != (doc["human"]["revision"] if doc["human"] else 0): raise SafetyError("review_revision_conflict")
+    if not isinstance(patch, dict) or not patch or set(patch) - {"verdict", "reasons"}: raise SafetyError("invalid_review_patch")
+    if "verdict" in patch and (not isinstance(patch["verdict"], str) or patch["verdict"] not in VERDICTS): raise SafetyError("invalid_verdict")
+    if "reasons" in patch and (not isinstance(patch["reasons"], list) or len(patch["reasons"]) > 100 or
+            any(not isinstance(r, str) or len(r) > 1000 for r in patch["reasons"])): raise SafetyError("invalid_review_reasons")
+    if not reason.strip() or len(reason) > 4000: raise SafetyError("review_reason_required")
+    row = SafetyReview(item_id=item_id, result_id=result_id, revision=expected_revision + 1,
+        patch_json=canonical(patch), reason=reason, actor=actor, created_at=now())
+    db.add(row); db.flush(); return row
+
+
+def update_reference(db, item_id, *, verdict, expected_revision, actor, confirmed):
+    item = db.get(SafetyItem, item_id)
+    if item is None: raise SafetyError("safety_item_not_found")
+    locked_run(db, item.run_id)
+    reference = latest(db, SafetyReference, item_id, SafetyReference.revision)
+    if expected_revision != (reference.revision if reference else 0): raise SafetyError("reference_revision_conflict")
+    if not confirmed or verdict not in VERDICTS: raise SafetyError("reference_confirmation_required")
+    archive_statistics(db, item.run_id)
+    row = SafetyReference(item_id=item_id, revision=expected_revision + 1, verdict=verdict, actor=actor, created_at=now())
+    db.add(row); db.flush(); return row
+
+
+def control(db, run_id, action):
+    run = locked_run(db, run_id)
+    if action == "pause" and run.status in {"running", "paused"}: run.status = "paused"
+    elif action == "resume" and run.status in {"paused", "running"}: run.status = "running"
+    elif action == "cancel":
+        run.status = "cancelled"
+        for item in db.scalars(select(SafetyItem).where(SafetyItem.run_id == run.id, SafetyItem.status.in_(["queued", "freezing"]))):
+            item.status = "cancelled"
+    else: raise SafetyError("invalid_round_action")
+    return run
+
+
+def retry_item(db, item_id):
+    item = db.get(SafetyItem, item_id)
+    if item is None: raise SafetyError("safety_item_not_found")
+    run = locked_run(db, item.run_id)
+    if run.status == "cancelled" or item.status != "failed": raise SafetyError("item_not_retryable")
+    item.status = "freezing"; item.error_code = None; item.next_attempt_at = ""
+    # Each explicit supplement permits one more bounded group of three attempts.
+    if run.status == "completed": run.status = "running"
+
+
+def recompute(db, run_id, *, rules, expected_revision, actor):
+    rules = validate_rules(rules); run = locked_run(db, run_id)
+    if run.rule_revision != expected_revision: raise SafetyError("rule_revision_conflict")
+    archive_statistics(db, run_id)
+    run.rule_revision += 1
+    db.add(SafetyRuleVersion(run_id=run_id, revision=run.rule_revision, rules_json=canonical(rules), actor=actor, created_at=now()))
+    for item in db.scalars(select(SafetyItem).where(SafetyItem.run_id == run_id)):
+        attempt = latest(db, SafetyAttempt, item.id, SafetyAttempt.sequence_no)
+        if not attempt or attempt.status != "completed" or not attempt.raw_json: continue
+        result = interpret(json.loads(attempt.raw_json), rules, data_id=attempt.id)
+        db.add(SafetyResult(id=uuid.uuid4().hex, item_id=item.id, attempt_id=attempt.id,
+            rule_revision=run.rule_revision, result_json=canonical(result), created_at=now()))
+    db.flush(); return run
+
+
+def statistics(db, run_id):
+    counts = {"total": 0, "completed": 0, "failed": 0, "cancelled": 0, "preparing": 0, "reviewed": 0,
+              "reference_count": 0, "raw_matches": 0, "effective_matches": 0}
+    verdicts = {v: 0 for v in VERDICTS}
+    for _, doc in source_rows(db, run_id):
+        counts["total"] += 1
+        if doc["status"] in {"completed", "failed", "cancelled"}: counts[doc["status"]] += 1
+        if doc["status"] == "freezing": counts["preparing"] += 1
+        counts["reviewed"] += bool(doc["human"])
+        effective = doc["effective"] or {}; raw = doc["raw"] or {}
+        if effective.get("verdict") in VERDICTS: verdicts[effective["verdict"]] += 1
+        if doc["reference"] and raw.get("verdict") in VERDICTS:
+            counts["reference_count"] += 1
+            counts["raw_matches"] += raw["verdict"] == doc["reference"]["verdict"]
+            counts["effective_matches"] += effective.get("verdict") == doc["reference"]["verdict"]
+    usage = dict(db.execute(select(SafetyAttempt.usage_state, func.count()).join(SafetyItem)
+        .where(SafetyItem.run_id == run_id).group_by(SafetyAttempt.usage_state)).all())
+    total = counts["reference_count"]
+    return {**counts, "verdicts": verdicts, "accuracy": counts["raw_matches"] / total if total else None,
+        "effective_accuracy": counts["effective_matches"] / total if total else None,
+        "execution_finished": counts["completed"] + counts["failed"] + counts["cancelled"] == counts["total"],
+        "confirmed_requests": usage.get("confirmed", 0), "uncertain_requests": usage.get("uncertain", 0),
+        "expected_requests": counts["total"], "actual_cost": None, "estimated_cost": None,
+        "rule_revision": db.get(SafetyRun, run_id).rule_revision, "computed_at": now()}
+
+
+def archive_statistics(db, run_id):
+    db.add(SafetyStatistics(id=uuid.uuid4().hex, run_id=run_id, statistics_json=canonical(statistics(db, run_id)), created_at=now()))
+
+
+def source_rows(db, run_id, item_id=None):
+    run = db.get(SafetyRun, run_id)
+    if not run: return
+    q = select(SafetyItem).where(SafetyItem.run_id == run_id).order_by(SafetyItem.id)
+    if item_id is not None: q = q.where(SafetyItem.id == str(item_id))
+    cursor = ""
+    while True:
+        rows = db.scalars(q.where(SafetyItem.id > cursor).limit(100)).all()
+        if not rows: return
+        for document in item_payloads(db, rows, run): yield run, document
+        cursor = rows[-1].id
