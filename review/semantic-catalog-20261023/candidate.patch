+from app.database import Base
+from app.models import Asset, BaselineSet, BaselineSetItem, ModelRegistryEntry, ModelConfig, User, ProductionRun, ProductionStepAttempt
+from app.safety_rules import DEFAULT_RULES
+from app.texture_regression import TextureRun, TextureItem, TextureResult, create_round, control, source_rows, review_item, statistics, update_reference
+from app.texture_worker import tick
+
+
+@pytest.fixture
+def setup(tmp_path, monkeypatch):
+    from test_workflow_working_copies import _seed_managed_dependencies
+    from app.texture_mechanism import ensure_category
+    import app.workflow_fixture_executor as executor
+    engine = create_engine(f"sqlite:///{tmp_path / 'texture.db'}")
+    Base.metadata.create_all(engine)
+    sessions = sessionmaker(bind=engine, expire_on_commit=False)
+    settings = SimpleNamespace(data_dir=tmp_path, upload_dir=tmp_path / "images")
+    settings.upload_dir.mkdir()
+    with sessions() as db:
+        _seed_managed_dependencies(db); ensure_category(db, "ops")
+        db.add(User(username="ops", is_admin=True, is_active=True))
+        model = db.scalar(select(ModelRegistryEntry)); model.protocol = "openai_chat"
+        db.get(ModelConfig, model.source_model_config_id).protocol = "openai_chat"
+        Image.new("RGB", (12, 12), "brown").save(settings.upload_dir / "tile.png")
+        data = (settings.upload_dir / "tile.png").read_bytes()
+        asset = Asset(original_name="tile.png", stored_name="tile.png", mime_type="image/png", size_bytes=len(data),
+            sha256=hashlib.sha256(data).hexdigest(), category_key="texture")
+        db.add(asset); db.flush()
+        baseline = BaselineSet(category_key="texture", name="贴图样本", default_expected_level="L1", fingerprint="f" * 64, created_by="ops")
+        db.add(baseline); db.flush()
+        db.add(BaselineSetItem(baseline_set_id=baseline.id, asset_id=asset.id, expected_level=None,
+            truth_contract_key="texture-review.v1", expected_result_json='{"verdict":null}',
+            asset_snapshot_json='{"workflow_input":{"classification":"石材"}}'))
+        db.commit(); baseline_id = baseline.id; model_id = model.id
+    monkeypatch.setattr(executor, "SessionLocal", sessions)
+    import app.workflow_node_executors as nodes
+    original_fixture = nodes._deterministic_schema_value
+    def fixture_value(schema):
+        if "checks" in schema.get("properties", {}):
+            keys = schema["properties"]["checks"]["items"]["properties"]["rule_key"]["enum"]
+            return {"checks": [{"rule_key": key, "verdict": "pass", "reasons": [], "evidence": "本地模拟：连续纹理", "confidence": .8} for key in keys]}
+        return original_fixture(schema)
+    monkeypatch.setattr(nodes, "_deterministic_schema_value", fixture_value)
+    yield engine, sessions, settings, baseline_id, model_id
+    engine.dispose()
+
+
+def make(setup, *, safety=False, request="texture-test"):
+    engine, sessions, settings, baseline_id, model_id = setup
+    with sessions() as db:
+        run = create_round(db, request_id=request, name="贴图审核测试", baseline_set_id=baseline_id,
+            model_registry_id=model_id, selected_rules=["uv_layout"], safety_selected=safety,
+            safety_rules=DEFAULT_RULES, partial_scope_confirmed=True, actor="ops")
+        config = json.loads(run.config_json); config["model_execution_mode"] = "simulated"  # isolated fixture only
+        run.config_json = json.dumps(config); db.commit()
+    return request
+
+
+def prepare(setup):
+    engine, _, settings, *_ = setup
+    assert tick(engine, settings=settings)
+    assert tick(engine, settings=settings)
+
+
+def execute_native():
+    from app.workflow_fixture_executor import process_runtime_step_once
+    count = 0
+    while process_runtime_step_once("texture-test-worker"):
+        count += 1
+        assert count <= 8
+    return count
+
+
+def test_native_round_uses_frozen_inputs_and_versions_human_reference(setup):
+    engine, sessions, settings, *_ = setup
+    run_id = make(setup); prepare(setup)
+    (settings.upload_dir / "tile.png").write_bytes(b"live-source-changed")
+    assert execute_native() == 4
+    assert tick(engine, settings=settings)
+    with sessions() as db:
+        run, doc = next(source_rows(db, run_id))
+        assert doc["status"] == "completed" and doc["raw"]["execution_complete"]
+        assert doc["input_preparation"]["preview_alias"]["stored_name"].startswith("texture-frozen-")
+        assert doc["raw"]["validation_scope"]["excluded_rules"] == ["similarity_lookup", "upload_time_order"]
+        assert statistics(db, run_id)["raw_accuracy"] is None
+        review_item(db, doc["item_id"], result_id=doc["result_id"], expected_revision=0,
+            patch={"verdict": "reject", "reasons": ["人工确认业务问题"]}, reason="核对原图", actor="ops")
+        from app.texture_regression import TextureStatistics
+        archived = db.scalar(select(TextureStatistics).order_by(TextureStatistics.revision))
+        assert archived is not None and json.loads(archived.summary_json)["human_reviewed"] == 0
+        update_reference(db, doc["item_id"], verdict="reject", expected_revision=0, actor="ops", confirmed=True)
+        db.commit()
+        summary = statistics(db, run_id)
+        assert summary["reference_count"] == 1 and summary["effective_accuracy"] == 1
+        doc = next(source_rows(db, run_id))[1]
+        assert doc["raw"]["verdict"] == "pass" and doc["effective"]["verdict"] == "reject"
+
+
+def test_pause_gates_claims_without_invalidating_inflight_output(setup):
+    from app.workflow_runtime import claim_next_runtime_step, complete_runtime_step
+    from app.workflow_snapshot_store import read_run_snapshot_document
+    from app.workflow_node_executors import NodeExecutionContext, execute_native_node
+    engine, sessions, settings, *_ = setup
+    run_id = make(setup); prepare(setup)
+    with sessions() as db:
+        attempt_id = claim_next_runtime_step(db, "inflight-texture", global_limit=4)
+        attempt = db.get(ProductionStepAttempt, attempt_id)
+        token = attempt.lease_token; db.commit()
+    with sessions() as db:
+        control(db, run_id, "pause"); db.commit()
+    with sessions() as db:
+        attempt = db.get(ProductionStepAttempt, attempt_id); production = db.get(ProductionRun, attempt.run_id)
+        snapshot = read_run_snapshot_document(production)
