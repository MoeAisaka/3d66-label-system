+def test_image_preview_uses_frozen_content_after_source_removed(context, monkeypatch, tmp_path):
+    import io, hashlib
+    from PIL import Image
+    from types import SimpleNamespace
+    from app.safety_worker import tick
+    sessions, login, _ = context
+    settings = SimpleNamespace(data_dir=tmp_path, upload_dir=tmp_path/'uploads'); settings.upload_dir.mkdir()
+    monkeypatch.setattr('app.safety_regression_api.get_settings', lambda: settings)
+    monkeypatch.setenv('ALIBABA_CLOUD_ACCESS_KEY_ID','fixture-id'); monkeypatch.setenv('ALIBABA_CLOUD_ACCESS_KEY_SECRET','fixture-secret')
+    buffer=io.BytesIO(); Image.new('RGB',(8,8),'blue').save(buffer,'PNG'); data=buffer.getvalue()
+    path=settings.upload_dir/'preview.png'; path.write_bytes(data)
+    with sessions() as db:
+        asset=Asset(original_name='preview.png',stored_name='preview.png',mime_type='image/png',size_bytes=len(data),sha256=hashlib.sha256(data).hexdigest(),category_key='model_3d_su')
+        db.add(asset); db.commit(); aid=asset.id; engine=db.get_bind()
+    operator,_=login('category_manager',['model_3d_su'])
+    response=operator.post('/api/safety-regressions',json={'request_id':'preview-safety','name':'preview','category_key':'model_3d_su','kind':'image','service':'postImageCheckByVL','asset_ids':[aid]})
+    assert response.status_code==200,response.text
+    detail=operator.get('/api/safety-regressions/preview-safety').json(); item=detail['items'][0]
+    assert item['input_url'] is None and item['status']=='freezing'
+    class NoProvider:
+        region='cn-shanghai'
+        def moderate_image(self,*a): raise AssertionError('preparation must not invoke provider')
+    assert tick(engine,settings=settings,provider=NoProvider())
+    path.unlink()
+    detail=operator.get('/api/safety-regressions/preview-safety').json(); url=detail['items'][0]['input_url']
+    response=operator.get(url); assert response.status_code==200 and response.content==data
+    (tmp_path/'stock-safety'/'inputs'/hashlib.sha256(data).hexdigest()).write_bytes(b'changed')
+    assert operator.get(url).status_code==409
