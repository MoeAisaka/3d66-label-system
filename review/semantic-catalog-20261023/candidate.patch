+        return {"items": [summary(row) for row in rows], "total": db.scalar(select(func.count(TextureRun.id)))}
+
+    @router.get("/api/texture-regressions/{run_id}")
+    def detail(run_id: str, offset: int = Query(0, ge=0), limit: int = Query(24, ge=1, le=100), user=Depends(current_user), db: Session = Depends(get_db)):
+        run = run_row(db, run_id)
+        ids = list(db.scalars(select(TextureItem.id).where(TextureItem.run_id == run.id).order_by(TextureItem.id).offset(offset).limit(limit)))
+        items = [doc for _, doc in source_rows(db, run.id, item_ids=ids)]
+        for doc in items:
+            prepared = doc["input_preparation"]
+            doc["preview_url"] = f"/api/texture-regressions/{run.id}/items/{doc['item_id']}/input/preview" if "preview" in prepared.get("available_inputs", []) else None
+            doc.pop("result_configuration", None)
+            for field in ("raw", "effective"):
+                if doc[field]: doc[field] = {key: value for key, value in doc[field].items()
+                    if key not in {"raw_checks", "business_evidence", "safety_evidence"}}
+        safety_rules = None; safety_revision = None
+        if run.safety_run_id:
+            from .safety_regression import SafetyRun, SafetyRuleVersion
+            safety_run = db.get(SafetyRun, run.safety_run_id); safety_revision = safety_run.rule_revision
+            safety_rules = json.loads(db.scalar(select(SafetyRuleVersion.rules_json).where(
+                SafetyRuleVersion.run_id == safety_run.id, SafetyRuleVersion.revision == safety_revision)))
+        return {**summary(run), "statistics": statistics(db, run.id), "usage": usage(db, run.id), "items": items,
+            "current_safety_rules": safety_rules, "safety_rule_revision": safety_revision, "offset": offset, "limit": limit,
+            "total": db.scalar(select(func.count(TextureItem.id)).where(TextureItem.run_id == run.id))}
+
+    @router.get("/api/texture-regressions/{run_id}/items/{item_id}/input/{role}")
+    def input_file(run_id: str, item_id: str, role: Literal["preview", "original_file"], user=Depends(current_user), db: Session = Depends(get_db)):
+        item = item_row(db, run_id, item_id); snapshot = json.loads(item.input_snapshot_json)[role]; sha = snapshot.get("sha256", "")
+        if not isinstance(sha, str) or not re.fullmatch(r"[0-9a-f]{64}", sha): raise HTTPException(409, "输入身份不完整")
+        path = get_settings().data_dir / "stock-texture" / "inputs" / sha
+        if not path.is_file(): raise HTTPException(409, "固定输入尚未准备好")
+        with path.open("rb") as file:
+            if hashlib.file_digest(file, "sha256").hexdigest() != sha: raise HTTPException(409, "固定输入校验失败")
+        mime = json.loads(item.preparation_json).get(role + "_alias", {}).get("mime_type", "application/octet-stream")
+        return FileResponse(path, media_type=mime, headers={"X-Content-Type-Options": "nosniff"})
+
+    @router.post("/api/texture-regressions/{run_id}/control/{action}")
+    def control_round(run_id: str, action: Literal["pause", "resume", "cancel"], user=Depends(current_user), db: Session = Depends(get_db)):
+        writable(user); run_row(db, run_id)
+        return execute(db, lambda: summary(control(db, run_id, action)))
+
+    @router.post("/api/texture-regressions/{run_id}/items/{item_id}/review")
+    def review(run_id: str, item_id: str, payload: ReviewSafetyItem, user=Depends(current_user), db: Session = Depends(get_db)):
+        writable(user); item_row(db, run_id, item_id)
+        return execute(db, lambda: {"revision": review_item(db, item_id, actor=user.username, **payload.model_dump()).revision})
+
+    @router.post("/api/texture-regressions/{run_id}/recompute")
+    def recompute_round(run_id: str, payload: RecomputeTextureRound, user=Depends(current_user), db: Session = Depends(get_db)):
+        writable(user); run_row(db, run_id)
+        return execute(db, lambda: summary(recompute(db, run_id, actor=user.username, **payload.model_dump())))
+
+    @router.post("/api/texture-regressions/{run_id}/items/{item_id}/reference")
+    def reference(run_id: str, item_id: str, payload: ReferenceRequest, user=Depends(current_user), db: Session = Depends(get_db)):
+        writable(user); item_row(db, run_id, item_id)
+        return execute(db, lambda: {"revision": update_reference(db, item_id, actor=user.username, **payload.model_dump()).revision})
+
+    @router.post("/api/texture-regressions/{run_id}/items/{item_id}/retry")
+    def retry(run_id: str, item_id: str, user=Depends(current_user), db: Session = Depends(get_db)):
+        writable(user); item_row(db, run_id, item_id)
+        return execute(db, lambda: (retry_item(db, item_id), {"accepted": True})[1])
+
+    @router.get("/api/texture-regressions/{run_id}/items/{item_id}/history")
+    def history(run_id: str, item_id: str, user=Depends(current_user), db: Session = Depends(get_db)):
+        item_row(db, run_id, item_id)
+        return {"results": [{"id": row.id, "revision": row.revision, "result": json.loads(row.result_json), "created_at": row.created_at}
+            for row in db.scalars(select(TextureResult).where(TextureResult.item_id == item_id).order_by(TextureResult.revision))],
+            "reviews": [{"revision": row.revision, "patch": json.loads(row.patch_json), "reason": row.reason, "actor": row.actor, "created_at": row.created_at}
+                for row in db.scalars(select(TextureReview).where(TextureReview.item_id == item_id).order_by(TextureReview.revision))],
+            "references": [{"revision": row.revision, "verdict": row.verdict, "actor": row.actor, "created_at": row.created_at}
+                for row in db.scalars(select(TextureReference).where(TextureReference.item_id == item_id).order_by(TextureReference.revision))]}
+
+    @router.get("/api/texture-regressions/{run_id}/versions")
+    def versions(run_id: str, user=Depends(current_user), db: Session = Depends(get_db)):
+        run_row(db, run_id)
+        return {"statistics": [{"revision": row.revision, "summary": json.loads(row.summary_json), "created_at": row.created_at}
+            for row in db.scalars(select(TextureStatistics).where(TextureStatistics.run_id == run_id).order_by(TextureStatistics.revision))]}
+    return router
