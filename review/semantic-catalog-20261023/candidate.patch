+"""Frozen texture-review rules and deterministic, non-short-circuit reduction.
+
+Business decisions are independent of Ali content safety. Stock regression
+never queries similar materials or compares upload times. This module makes
+no provider or business-network calls.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import math
+from pathlib import Path
+
+BUSINESS_SOURCE = 'https://alidocs.dingtalk.com/i/nodes/Y1OQX0akWm3lgBg5uA4zKB7LJGlDd3mE'
