+import json
+from sqlalchemy import select
+from tests.test_employee_access import context
+from app.models import Asset, RuntimeOutboxEvent
+from app.module_api import owner
+from app.safety_regression import SafetyRun, SafetyItem, SafetyAttempt, SafetyResult
+from app.stock_exports import now
+
+
+def test_employee_cookie_permissions_foreign_assets_and_machine_surface(context, monkeypatch):
+    sessions, login, _ = context
+    # Fixture-only strings, never actual credentials or a provider call.
+    monkeypatch.setenv('ALIBABA_CLOUD_ACCESS_KEY_ID', 'fixture-id')
+    monkeypatch.setenv('ALIBABA_CLOUD_ACCESS_KEY_SECRET', 'fixture-secret')
+    payload = {'request_id': 'api-safety', 'name': '接口权限测试', 'category_key': 'model_3d_su',
+        'kind': 'text', 'service': 'comment_detection_pro', 'texts': [{'content': 'fixture'}]}
+    viewer, _ = login('viewer', [])
+    assert viewer.post('/api/safety-regressions', json=payload).status_code == 403
+    wrong, _ = login('category_manager', ['space_image'])
+    assert wrong.post('/api/safety-regressions', json=payload).status_code == 403
+    operator, _ = login('category_manager', ['model_3d_su'])
+    response = operator.post('/api/safety-regressions', json=payload)
+    assert response.status_code == 200, response.text
+    assert 'fixture-secret' not in response.text
+    assert operator.post('/api/safety-regressions', json=payload).status_code == 200
+    assert operator.post('/api/safety-regressions', json=payload | {'incremental_enabled': True}).status_code == 422
+    assert operator.post('/api/safety-regressions', json=payload, headers={'Origin': 'https://attacker.invalid'}).status_code == 403
+    assert owner('/api/safety-regressions') == 'stock'
+    with sessions() as db:
+        item = db.scalar(select(SafetyItem))
+        aid = item.asset_id
+        asset = db.get(Asset, aid); asset.category_key = 'space_image'; db.commit()
+    assert operator.post('/api/safety-regressions/api-safety/control/pause').status_code == 403
+    assert viewer.get('/api/safety-regressions/api-safety').status_code == 200
+    monkeypatch.delenv('ALIBABA_CLOUD_ACCESS_KEY_SECRET')
+    assert not viewer.get('/api/safety-regressions/capabilities').json()['configured']
+    assert operator.post('/api/safety-regressions', json=payload | {'request_id': 'unconfigured'}).status_code == 503
+
+
+def test_safety_result_snapshot_and_manual_priority_integrate_with_writer(context, monkeypatch):
+    from app.stock_writes import create_plan, confirm_plan, scan_plan, StockWriteItem
+    from app.safety_regression import create_round, review_item, item_payload
+    from app.safety_rules import DEFAULT_RULES
+    from app.config import get_settings
+    sessions, login, _ = context
+    operator, user_id = login('product_rd', [])
+    from app.models import User
+    with sessions() as db:
+        user = db.get(User, user_id)
+        run = create_round(db, request_id='write-safety', name='写出安全审核', category='model_3d_su', kind='text',
+            service='comment_detection_pro', rules=DEFAULT_RULES, asset_ids=[], texts=[{'content': 'fixture'}],
+            actor=user.username, settings=get_settings())
+        item = db.scalar(select(SafetyItem)); item.status = 'completed'; item.attempt_count = 1
+        a = SafetyAttempt(id='safety-a', item_id=item.id, sequence_no=1, status='completed',
+            raw_json='{"Code":200,"Data":{"RiskLevel":"none","Result":[{"Label":"nonLabel"}]}}', created_at=now(), usage_state='confirmed')
+        db.add(a); db.flush()
+        result = SafetyResult(id='safety-result', item_id=item.id, attempt_id=a.id, rule_revision=1,
+            result_json='{"verdict":"pass","reasons":[]}', created_at=now())
+        db.add(result); db.flush()
+        plan = create_plan(db, source_kind='safety', run_id=run.id, selection={}, result_mode='effective', actor=user.username,
+            targets=[{'name':'fixture','url':'http://192.168.1.31:9988/receive'}]); db.flush()
+        confirm_plan(db, plan.id, expected_revision=plan.revision, actor=user.username)
+        review_item(db,item.id,result_id=result.id,expected_revision=0,patch={'verdict':'reject'},reason='人工检查',actor=user.username)
+        scan_plan(db,plan.id); db.flush()
+        rows = db.scalars(select(StockWriteItem).order_by(StockWriteItem.id)).all()
+        assert len(rows)==2 and rows[-1].status=='queued' and rows[-1].human_revision==1
+        doc=json.loads(rows[-1].document_json)
+        assert doc['effective']['verdict']=='reject' and doc['raw']['verdict']=='pass'
+        assert doc['result_configuration']['rule_revision']==1
+        db.commit()
+    assert operator.get('/api/stock-writes/plans?source_kind=safety&run_id=write-safety').status_code==200
+
