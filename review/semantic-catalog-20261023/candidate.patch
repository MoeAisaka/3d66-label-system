+import copy
+import pytest
+from app.texture_audit import (RULES, TextureAuditError, freeze_policy, output_schema, reduce_checks, prompt_text)
+
+
+def response(key, verdict='pass', reasons=None, **extra):
+    return {'rule_key':key,'verdict':verdict,'reasons':reasons or [],'evidence':'原图可见证据',
+        'confidence':0.9,**extra}
+
+
+def test_rule_snapshot_excludes_duplicate_and_upload_time_from_stock_scope():
+    frozen=freeze_policy(['uv_layout','irrelevant_watermark'])
+    assert frozen['mode']=='stock' and frozen['excluded_rules']==['similarity_lookup','upload_time_order']
+    assert frozen['full_scope'] is False and len(frozen['policy_hash'])==64
+    assert 'similarity_lookup' not in RULES
+    with pytest.raises(TextureAuditError): freeze_policy(['similarity_lookup'])
+    assert output_schema(frozen)['properties']['checks']['items']['properties']['rule_key']['enum']==['uv_layout','irrelevant_watermark']
+
+
+def test_all_selected_results_and_all_reasons_survive_a_security_rejection():
+    policy=freeze_policy(['uv_layout','irrelevant_watermark'])
+    actual=reduce_checks(policy,[response('uv_layout','reject',['UV分解不可独立使用']),
+        response('irrelevant_watermark','reject',['无关竞品水印'])],available_inputs={'preview'},
+        safety={'status':'completed','verdict':'reject','reasons':['安全风险']})
+    assert actual['verdict']=='reject' and actual['execution_complete']
+    assert len(actual['reasons'])==3 and len(actual['rule_results'])==2
+    assert not actual['full_scope_evaluated']
+    assert actual['requires_partial_scope_confirmation']
+
+
+def test_missing_original_or_classification_is_unverifiable_never_not_applicable():
+    policy=freeze_policy(['panorama_hdr','invalid_stitch'])
+    rows=[response('panorama_hdr'),response('invalid_stitch','not_applicable')]
+    result=reduce_checks(policy,rows,available_inputs={'preview'},safety=None)
+    assert not result['execution_complete'] and not result['can_write']
+    assert all(r['status']=='unverifiable' for r in result['rule_results'])
+    assert result['verdict']=='review' and result['raw_checks']==rows
+
+
+def test_duplicates_missing_rows_unknown_verdict_and_unsupported_keys_are_not_silent_success():
+    policy=freeze_policy(['uv_layout','irrelevant_watermark'])
+    result=reduce_checks(policy,[response('uv_layout'),response('uv_layout','reject'),response('foreign-rule')],available_inputs={'preview'},safety=None)
+    assert not result['execution_complete'] and not result['can_write']
+    assert result['rule_results'][0]['status']=='failed' and result['rule_results'][1]['status']=='unverifiable'
+    assert 'unexpected_rule_key' in result['guards']
+    result=reduce_checks(freeze_policy(['uv_layout']),[response('uv_layout','new_provider_enum')],available_inputs={'preview'},safety=None)
+    assert result['verdict']=='review' and not result['execution_complete']
+
+
+def test_not_applicable_needs_explicit_evidence_and_does_not_hide_failure():
+    policy=freeze_policy(['public_figure_portrait'])
+    result=reduce_checks(policy,[response('public_figure_portrait','not_applicable',evidence='')],available_inputs={'preview'},safety=None)
+    assert not result['execution_complete']
+    result=reduce_checks(policy,[response('public_figure_portrait','not_applicable')],available_inputs={'preview'},safety=None)
+    assert result['execution_complete'] and result['verdict']=='pass'
+    failed=reduce_checks(policy,[response('public_figure_portrait')],available_inputs={'preview'},safety={'status':'failed','error':'network'})
+    assert failed['verdict']=='review' and not failed['can_write']
+
+
+def test_rule_exceptions_are_frozen_and_cannot_be_replaced_by_mutable_catalog():
+    policy=freeze_policy(['irrelevant_watermark','invalid_stitch','strong_surface_shadow','ai_structure_artifacts'])
+    watermark=next(r for r in policy['rules'] if r['key']=='irrelevant_watermark')
+    assert any('题字' in text and '印章' in text for text in watermark['exceptions'])
+    ai=next(r for r in policy['rules'] if r['key']=='ai_structure_artifacts')
+    assert any('不单凭' in text for text in ai['exceptions'])
+    broken=copy.deepcopy(policy);broken['rules'][0]['title']='tampered'
+    with pytest.raises(TextureAuditError,match='policy_snapshot_changed'):
+        reduce_checks(broken,[],available_inputs={'preview'},safety=None)
+
+
+def test_partial_scope_requires_explicit_confirmation_and_malformed_safety_cannot_pass():
+    policy=freeze_policy(['uv_layout']);rows=[response('uv_layout')]
+    assert not reduce_checks(policy,rows,available_inputs={'preview'})['can_write']
+    actual=reduce_checks(policy,rows,available_inputs={'preview'},partial_scope_confirmed=True)
+    assert actual['can_write'] and actual['validation_scope']['excluded_rules']==['similarity_lookup','upload_time_order']
+    malformed=reduce_checks(policy,rows,available_inputs={'preview'},partial_scope_confirmed=True,
+        safety={'status':'completed','verdict':[],'reasons':[]})
+    assert not malformed['can_write'] and malformed['verdict']=='review'
+    with pytest.raises(TextureAuditError):reduce_checks(policy,rows,available_inputs={'preview'},partial_scope_confirmed='yes')
+
+
+def test_company_standard_text_is_frozen_instead_of_only_sending_an_unreadable_link():
+    policy=freeze_policy()
+    assert policy['full_scope'] and len(policy['rules'])==19
+    assert len(policy['company_standard']['rows'])==82
+    text=prompt_text(policy)
+    assert '中国地图完整性' in text and 'not_applicable' in text
+    assert '不做相似检索或上传时间比较' in text
+    old=copy.deepcopy(policy['company_standard'])
+    policy['company_standard']['rows'][0]['high']='changed after launch'
+    with pytest.raises(TextureAuditError):prompt_text(policy)
+    assert old!=policy['company_standard']
