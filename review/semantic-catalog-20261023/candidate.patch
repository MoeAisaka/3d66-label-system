+import copy
+import pytest
+from app.safety_rules import DEFAULT_RULES, SafetyError, interpret, validate_rules
+
+
+def body(level="none", entries=None):
+    return {"Code": 200, "RequestId": "vendor-r", "Data": {"RiskLevel": level, "DataId": "item-1",
+            "Result": [{"Label": "nonLabel"}] if entries is None else entries}}
+
+
+def test_all_reasons_and_per_round_mapping_without_mutating_response():
+    raw = body("high", [{"Label": "pornographic_adult", "Confidence": 95, "FutureField": {"keep": True}},
+                        {"Label": "political_entity", "Confidence": 88, "RiskWords": "word"}])
+    before = copy.deepcopy(raw)
+    assert interpret(raw, DEFAULT_RULES)["verdict"] == "reject"
+    assert len(interpret(raw, DEFAULT_RULES)["reasons"]) == 2
+    rules = copy.deepcopy(DEFAULT_RULES); rules["risk_levels"]["high"] = "review"
+    assert interpret(raw, rules)["verdict"] == "review"
+    assert raw == before
+
+
+@pytest.mark.parametrize("change", [lambda r: r["Data"].pop("RiskLevel"),
+    lambda r: r["Data"].update(RiskLevel="new_vendor_enum"),
+    lambda r: r["Data"].update(Result=[]),
+    lambda r: r["Data"].update(Result=[{"Label": "unexpected"}]),
+    lambda r: r["Data"].update(Result=[{"Label": "nonLabel", "Confidence": float("nan")}])])
+def test_unknown_or_malformed_detection_never_passes(change):
+    raw = body(); change(raw)
+    assert interpret(raw, DEFAULT_RULES)["verdict"] == "review"
+
+
+def test_alias_conflicts_and_wrong_correlation_are_not_accepted():
+    raw = body(); raw["Data"]["riskLevel"] = "high"
+    with pytest.raises(SafetyError, match="conflicting_provider_fields"): interpret(raw, DEFAULT_RULES)
+    with pytest.raises(SafetyError, match="provider_data_id_mismatch"): interpret(body(), DEFAULT_RULES, data_id="other")
+    raw = body(); raw["Data"]["riskLevel"] = raw["Data"].pop("RiskLevel")
+    assert interpret(raw, DEFAULT_RULES, data_id="item-1")["verdict"] == "pass"
+
+
+def test_vendor_failure_is_incomplete_not_content_rejection():
+    with pytest.raises(SafetyError) as e: interpret({"Code": 588}, DEFAULT_RULES)
+    assert e.value.retryable and e.value.raw == {"Code": 588}
+    with pytest.raises(SafetyError) as e: interpret({"Code": 403}, DEFAULT_RULES)
+    assert not e.value.retryable
+
+
+def test_thresholds_validate_and_missing_score_does_not_pass():
+    rules = copy.deepcopy(DEFAULT_RULES)
+    rules["labels"] = {"nonLabel": {"verdict": "reject", "min_confidence": 90}}
+    assert interpret(body(), rules)["verdict"] == "review"
+    rules["labels"]["nonLabel"]["min_confidence"] = True
+    with pytest.raises(SafetyError): validate_rules(rules)
+
+
+def test_label_rule_cannot_pretend_to_relax_risk_and_malformed_code_is_typed_error():
+    rules = copy.deepcopy(DEFAULT_RULES); rules['labels'] = {'risk': {'verdict':'pass','min_confidence':80}}
+    with pytest.raises(SafetyError, match='invalid_label_rule'): validate_rules(rules)
+    with pytest.raises(SafetyError, match='provider_error_unknown'): interpret({'Code': []}, DEFAULT_RULES)
