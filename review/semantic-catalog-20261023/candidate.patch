@@ -0,0 +1,203 @@
+import copy
+import hashlib
+import json
+from types import SimpleNamespace
+import pytest
+from sqlalchemy import create_engine, select
+from sqlalchemy.orm import Session
+from app.database import Base
+from app.models import Asset
+from app.safety_rules import DEFAULT_RULES, SafetyError
+from app.safety_regression import (SafetyRun, SafetyItem, SafetyAttempt, create_round, control,
+    review_item, recompute, item_payload, statistics, update_reference)
+from app.safety_worker import tick
+
+
+@pytest.fixture
+def setup(tmp_path):
+    engine = create_engine("sqlite:///" + str(tmp_path / "safety.db"))
+    Base.metadata.create_all(engine)
+    settings = SimpleNamespace(data_dir=tmp_path, upload_dir=tmp_path / "uploads")
+    settings.upload_dir.mkdir()
+    with Session(engine) as db: yield engine, db, settings
+    engine.dispose()
+
+
+def make(db, settings, request="safety-test", texts=None):
+    return create_round(db, request_id=request, name="安全审核测试", category="space_image", kind="text",
+        service="comment_detection_pro", rules=DEFAULT_RULES, asset_ids=[], texts=texts or [{"content": "hello"}],
+        actor="tester", settings=settings)
+
+
+class Provider:
+    region = "cn-shanghai"
+    calls = 0
+    def moderate_text(self, content, request_id, service):
+        self.calls += 1
+        return {"Code": 200, "RequestId": "real-raw", "Future": ["retained"], "Data": {
+            "DataId": request_id, "RiskLevel": "high", "Result": [{"Label": "risk", "Confidence": 90}]}}
+
+
+def run_tick(engine, settings, provider):
+    # Drive the explicit background input-preparation phase before one call.
+    for _ in range(100):
+        with Session(engine) as db:
+            pending = db.scalar(select(SafetyItem.id).join(SafetyRun).where(SafetyItem.status=='freezing',SafetyRun.status=='running').limit(1))
+        if not pending: break
+        if not tick(engine, settings=settings, provider=provider, authorize=lambda db, run: True): return False
+    return tick(engine, settings=settings, provider=provider, authorize=lambda db, run: True)
+
+
