+import json
+from pathlib import Path
+from types import SimpleNamespace
+import pytest
+from app.safety_provider import AliSafetyProvider, provider_configuration
+from app.safety_rules import SafetyError
+
+
+def test_calls_fixed_actions_preserves_unknown_response_and_disables_hidden_retries():
+    calls = []
+    raw = {"Code": 200, "Data": {"RiskLevel": "none", "Result": [{"Label": "nonLabel"}], "new": 123}}
+    class Client:
+        def call_api(self, params, request, runtime):
+            calls.append((params, request, runtime)); return {"body": raw}
+    provider = AliSafetyProvider(client=Client())
+    assert provider.moderate_text("text", "req-1", "comment_detection_pro") is raw
+    params, request, runtime = calls[0]
+    assert params.action == "TextModerationPlus" and params.protocol == "HTTPS"
+    assert json.loads(request.body["ServiceParameters"]) == {"content": "text", "dataId": "req-1"}
+    assert runtime.autoretry is False and runtime.max_attempts == 1
+    assert runtime.ignore_ssl is False
+    assert not hasattr(raw, "access_key_secret")
+
+
+def test_text_limit_fails_before_network_and_never_truncates():
+    class Client:
+        def call_api(self, *args): raise AssertionError("must not call")
+    provider = AliSafetyProvider(client=Client())
+    with pytest.raises(SafetyError, match="text_exceeds_service_limit"):
+        provider.moderate_text("字" * 601, "req", "comment_detection_pro")
+    with pytest.raises(SafetyError, match="unsupported_text_service"):
+        provider.moderate_text("test", "req", "arbitrary")
+
+
+def test_unconfigured_and_unapproved_region_are_explicit(monkeypatch):
+    for name in ("ALIBABA_CLOUD_ACCESS_KEY_ID", "ALIBABA_CLOUD_ACCESS_KEY_SECRET", "ALIBABA_CLOUD_SECURITY_TOKEN"):
+        monkeypatch.delenv(name, raising=False)
+    assert not provider_configuration()["configured"]
+    with pytest.raises(SafetyError, match="aliyun_credentials_unconfigured"): AliSafetyProvider()
+    with pytest.raises(SafetyError, match="unsupported_aliyun_region"): AliSafetyProvider(client=object(), region="evil.example")
+
+
+def test_sensitive_exception_is_not_exposed():
+    class Client:
+        def call_api(self, *args): raise RuntimeError("AccessKeySecret=never-log-this")
+    with pytest.raises(SafetyError) as e: AliSafetyProvider(client=Client()).moderate_text("hi", "req", "comment_detection_pro")
+    assert str(e.value) == "provider_transport_uncertain" and e.value.submitted
+    assert "never-log" not in str(e.value)
+
+
+def test_image_uses_scoped_temporary_upload_not_private_url(tmp_path):
+    from PIL import Image
+    path = tmp_path / "image.png"; Image.new("RGB", (8, 8)).save(path)
+    calls, uploads = [], []
+    token = {"AccessKeyId": "temporary-id", "AccessKeySecret": "temporary-secret", "SecurityToken": "sts",
+        "OssInternetEndPoint": "https://oss-cn-shanghai.aliyuncs.com", "BucketName": "moderation-temp",
+        "FileNamePrefix": "uploads/", "Expiration": 4102444800}
+    class Client:
+        def call_api(self, params, request, runtime):
+            calls.append((params.action, request.body))
+            return {"body": {"Code": 200, "Data": token}} if params.action == "DescribeUploadToken" else {"body": {"Code": 200, "Data": {"future": True}}}
+    def upload(**kwargs): uploads.append(kwargs)
+    provider = AliSafetyProvider(client=Client(), upload=upload)
+    assert provider.moderate_image(path, "req-1", "postImageCheckByVL")["Data"]["future"]
+    assert uploads[0]["object_name"] == "uploads/req-1.png"
+    params = json.loads(calls[-1][1]["ServiceParameters"])
+    assert params == {"ossBucketName": "moderation-temp", "ossObjectName": "uploads/req-1.png", "dataId": "req-1"}
+    assert "AccessKeySecret" not in json.dumps(params)
+    token["OssInternetEndPoint"] = "https://attacker.invalid"
+    with pytest.raises(SafetyError, match="invalid_upload_token"):
+        provider.moderate_image(path, "req-2", "postImageCheckByVL")
