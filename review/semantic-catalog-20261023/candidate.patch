+
+
+class TextureReference(Base):
+    __tablename__ = "texture_regression_references"
+    __table_args__ = (UniqueConstraint("item_id", "revision", name="uq_texture_reference_revision"),)
+    id: Mapped[int] = mapped_column(primary_key=True)
+    item_id: Mapped[str] = mapped_column(ForeignKey("texture_regression_items.id", ondelete="RESTRICT"), index=True)
+    revision: Mapped[int] = mapped_column(Integer)
+    verdict: Mapped[str] = mapped_column(String(24))
