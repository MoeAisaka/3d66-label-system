+def test_image_retry_and_original_delivery_use_frozen_copy(setup):
+    from PIL import Image
+    from app.safety_regression import retry_item
+    from app.stock_writes import freeze_artifact
+    engine, db, settings = setup
+    path = settings.upload_dir / 'original.png'; Image.new('RGB', (8, 8)).save(path)
+    digest = hashlib.sha256(path.read_bytes()).hexdigest()
+    asset = Asset(original_name='image', stored_name=path.name, mime_type='image/png', size_bytes=path.stat().st_size,
+        sha256=digest, category_key='space_image')
+    db.add(asset); db.flush()
+    run = create_round(db, request_id='image', name='image', category='space_image', kind='image', service='postImageCheckByVL',
+        rules=DEFAULT_RULES, asset_ids=[asset.id], texts=[], actor='tester', settings=settings)
+    db.commit()
+    class ImageProvider(Provider):
+        fail = True
+        def moderate_image(self, image_path, request_id, service):
+            assert hashlib.sha256(image_path.read_bytes()).hexdigest() == digest
+            if self.fail: raise SafetyError('provider_http_403')
+            return self.moderate_text('', request_id, service)
+    p = ImageProvider(); run_tick(engine, settings, p); db.expire_all()
+    path.unlink(); item = db.scalar(select(SafetyItem)); retry_item(db, item.id); db.commit()
+    p.fail = False; run_tick(engine, settings, p); db.expire_all()
+    assert item.status == 'completed'
+    descriptor = freeze_artifact(settings, SimpleNamespace(source_kind='safety'), {'file_source':'original'}, item_payload(db, item))
+    assert descriptor['sha256'] == digest
