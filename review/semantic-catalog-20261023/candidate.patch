+    _rule('incomplete','内容完整性','检查裁剪痕迹是否破坏独立使用，尤其是字画的文字、印章、人物和动物。','不完整',
+          exceptions=('木纹、石材及外景经裁剪仍可正常使用时，不单凭裁剪判不完整。',)),
