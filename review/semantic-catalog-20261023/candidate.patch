+"""Texture stock coordinator. Native model and Ali ledgers remain authoritative.
+
+This ledger only freezes samples, joins independent checks, and versions human
+decisions. It never writes grading results or changes an incremental binding.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import uuid
+from datetime import datetime, timezone
+
+from sqlalchemy import ForeignKey, Integer, String, Text, Boolean, UniqueConstraint, select, func
+from sqlalchemy.orm import Mapped, mapped_column
+
+from .database import Base, reserve_sqlite_immediate_transaction
+from .texture_audit import TextureAuditError, freeze_policy, reduce_checks
+
+
+def canonical(value): return json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":"), allow_nan=False)
+def digest(value): return hashlib.sha256(canonical(value).encode()).hexdigest()
+def now(): return datetime.now(timezone.utc).isoformat()
+
+
+class TextureRun(Base):
+    __tablename__ = "texture_regression_runs"
+    id: Mapped[str] = mapped_column(String(64), primary_key=True)
+    name: Mapped[str] = mapped_column(String(160))
+    category_key: Mapped[str] = mapped_column(String(40), index=True)
+    source_set_id: Mapped[int] = mapped_column(ForeignKey("baseline_sets.id", ondelete="RESTRICT"))
+    native_run_id: Mapped[int | None] = mapped_column(ForeignKey("baseline_regression_runs.id", ondelete="RESTRICT"), nullable=True)
+    safety_run_id: Mapped[str | None] = mapped_column(ForeignKey("safety_regression_runs.id", ondelete="RESTRICT"), nullable=True)
+    status: Mapped[str] = mapped_column(String(24), index=True)
+    request_hash: Mapped[str] = mapped_column(String(64))
+    config_json: Mapped[str] = mapped_column(Text)
+    error_code: Mapped[str | None] = mapped_column(String(100), nullable=True)
+    settlement_pending: Mapped[bool] = mapped_column(Boolean, default=True, server_default="1")
+    created_by: Mapped[str] = mapped_column(String(80))
+    created_at: Mapped[str] = mapped_column(String(40))
+    last_dispatched: Mapped[str] = mapped_column(String(40), default="", server_default="")
+
+
+class TextureItem(Base):
+    __tablename__ = "texture_regression_items"
+    __table_args__ = (UniqueConstraint("run_id", "source_item_id", name="uq_texture_run_source"),)
+    id: Mapped[str] = mapped_column(String(64), primary_key=True)
+    run_id: Mapped[str] = mapped_column(ForeignKey("texture_regression_runs.id", ondelete="RESTRICT"), index=True)
+    source_item_id: Mapped[int] = mapped_column(ForeignKey("baseline_set_items.id", ondelete="RESTRICT"))
+    asset_id: Mapped[int] = mapped_column(ForeignKey("assets.id", ondelete="RESTRICT"))
+    original_name: Mapped[str] = mapped_column(String(500))
+    input_snapshot_json: Mapped[str] = mapped_column(Text)
+    preparation_json: Mapped[str] = mapped_column(Text, default="{}", server_default="{}")
+    collected_source_hash: Mapped[str] = mapped_column(String(64), default="", server_default="")
+    status: Mapped[str] = mapped_column(String(24), index=True)
+    error_code: Mapped[str | None] = mapped_column(String(100), nullable=True)
+    native_item_id: Mapped[int | None] = mapped_column(ForeignKey("baseline_regression_items.id", ondelete="RESTRICT"), nullable=True)
+    production_run_id: Mapped[int | None] = mapped_column(ForeignKey("production_runs.id", ondelete="RESTRICT"), nullable=True, index=True)
+    safety_item_id: Mapped[str | None] = mapped_column(ForeignKey("safety_regression_items.id", ondelete="RESTRICT"), nullable=True)
+
+
+class TextureResult(Base):
+    __tablename__ = "texture_regression_results"
+    __table_args__ = (UniqueConstraint("item_id", "revision", name="uq_texture_result_revision"),)
+    id: Mapped[str] = mapped_column(String(64), primary_key=True)
+    item_id: Mapped[str] = mapped_column(ForeignKey("texture_regression_items.id", ondelete="RESTRICT"), index=True)
