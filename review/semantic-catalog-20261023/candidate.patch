+            'required_inputs':list(inputs), 'exceptions':list(exceptions), 'source':source}
+
+
+_CATALOG = [
+    _rule('uv_layout','UV 展开贴图','识别物体不同部位分解后汇集在同一平面的展开图。','暂不支持UV展开贴图'),
+    _rule('irrelevant_watermark','与贴图无关的水印','检查竞品水印、无关签名及辅助尺寸说明，结合图案用途判断。','贴图有水印',
