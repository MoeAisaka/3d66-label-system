+          <p className="text-sm text-muted-foreground">发起时范围共 {current.source_total} 条样本。未完成素材暂不建立请求，补跑完成后补写；下方按目标分别列出记录，保留各次结果版本。</p>
+          <div className="flex flex-wrap gap-2 text-sm">{Object.entries(current.counts).map(([state, count]) => <span key={state} className="rounded-lg bg-muted px-3 py-2">{labels[state] || state} {count}</span>)}</div>
+          {current.targets.map(t => <p key={t.id} className="break-all text-sm">{t.name} · {t.url} · {t.write_mode === "overwrite" ? "覆盖" : "追加"}</p>)}
+          {current.error_code && <p className="text-sm">{errors[current.error_code] || "配置有待处理事项，请检查详情。"}</p>}
+          {canWrite && current.status !== "cancelled" && <div className="space-y-3 rounded-xl border p-4">
+              <p className="text-sm text-muted-foreground">请核对目标及下方结果。确认也授权原范围内未完成素材的首次完整结果补写。请求未核实时，新版本不会越过旧请求。新增 AI 图替换已写图片会列为“等待确认”。</p>
+            <div className="flex flex-wrap gap-2"><Button variant="secondary" size="sm" disabled={pending} onClick={() => mutate.mutate({ path: `/api/stock-writes/plans/${planId}/refresh` })}>刷新结果预览</Button>
+              {current.status === "active" && <Button variant="secondary" size="sm" disabled={pending} onClick={() => mutate.mutate({ path: `/api/stock-writes/plans/${planId}/control/pause` })}>暂停写出</Button>}
+              {current.status === "paused" && <Button variant="secondary" size="sm" disabled={pending} onClick={() => mutate.mutate({ path: `/api/stock-writes/plans/${planId}/control/resume` })}>继续写出</Button>}
+              {current.status !== "draft" && <Button variant="ghost" size="sm" disabled={pending} onClick={() => mutate.mutate({ path: `/api/stock-writes/plans/${planId}/control/cancel` })}>取消后续写出</Button>}</div>
+            {current.status !== "paused" && <><label className="flex items-start gap-2 text-sm"><input type="checkbox" checked={confirmed} onChange={e => setConfirmed(e.target.checked)} className="mt-1" />已核对目标、当前全部待确认结果与写入方式，允许按本配置写出。</label>
+              <Button disabled={pending || !confirmed || !capabilities.data?.enabled} onClick={() => mutate.mutate({ path: `/api/stock-writes/plans/${planId}/confirm`, body: { expected_revision: current.revision, confirmed: true } })}>确认当前版本并写出</Button></>}
+          </div>}
+          <div className="min-w-0 space-y-3">{current.items.map(item => <div key={item.id} className="min-w-0 space-y-3 rounded-xl border p-4 text-sm">
+            <div className="flex flex-wrap items-start justify-between gap-3"><div className="min-w-0"><p className="break-all font-medium">{item.name || item.item_id} · 素材 {item.asset_id}</p><p className="text-muted-foreground">{current.targets.find(t => t.id === item.target_id)?.name} · {labels[item.status]} · {item.human_revision ? "含人工修订" : "未人工修订"}</p></div>
+              {canWrite && ["uncertain", "failed"].includes(item.status) && <Button variant="secondary" size="sm" disabled={pending} onClick={() => { setResolving(item); setEvidence(""); setOutcome("applied") }}>核实此请求</Button>}</div>
+            {item.error_code && <p className="break-all">{errors[item.error_code] || "此请求有待处理事项，请查看记录并核实。"}</p>}
+            <details><summary className="cursor-pointer">查看固定结果与请求记录</summary><pre className="mt-3 max-h-72 overflow-auto whitespace-pre-wrap break-all rounded-xl bg-muted p-3 text-xs">{JSON.stringify({ result: item.result, human: item.human, request_id: item.request_id, version: item.source_hash, error_code: item.error_code, history: item.history }, null, 2)}</pre></details>
+            {resolving?.id === item.id && <div className="space-y-3 border-t pt-3">
+              <p>先与接收端核对。重发沿用原编号与原内容，不会创建另一份请求。</p>
+              <select aria-label="请求核实结论" className={control} value={outcome} onChange={e => setOutcome(e.target.value)}><option value="applied">确认原请求已写入</option><option value="not_applied">确认未写入，关闭此旧请求</option><option value="retry">确认可以安全重发原请求</option></select>
+              <textarea aria-label="请求核实依据" className="min-h-24 w-full rounded-xl border p-3" maxLength={2000} value={evidence} onChange={e => setEvidence(e.target.value)} placeholder="填写接收端查证依据或沟通结论" />
+              <div className="flex flex-wrap gap-2"><Button size="sm" disabled={pending || !evidence.trim()} onClick={() => mutate.mutate({ path: `/api/stock-writes/items/${item.id}/resolve`, body: { expected_revision: item.revision, outcome, evidence, confirmed: true } })}>确认核实结论</Button><Button variant="secondary" size="sm" onClick={() => setResolving(null)}>返回</Button></div>
+            </div>}
+          </div>)}</div>
+          <div className="flex flex-wrap items-center justify-end gap-3 text-sm"><span>第 {Math.floor(offset / 20) + 1} 页 · 共 {current.total} 条目标记录</span><Button size="sm" variant="secondary" disabled={offset === 0} onClick={() => setOffset(n => Math.max(0, n - 20))}>上一页</Button><Button size="sm" variant="secondary" disabled={offset + 20 >= current.total} onClick={() => setOffset(n => n + 20)}>下一页</Button></div>
+        </section>}
+      </div>
+    </SecondaryDrawer>
+  </>
+}
