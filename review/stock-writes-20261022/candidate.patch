+def test_dns_rebinding_and_special_addresses_fail_but_company_lan_works():
+    def addresses(*args,**kwargs):return [(socket.AF_INET,socket.SOCK_STREAM,6,'',('192.168.1.31',80))]
+    assert validate_url('http://business.test/receive',resolve=True,resolver=addresses)[3]==['192.168.1.31']
+    def hostile(*args,**kwargs):return [(socket.AF_INET,socket.SOCK_STREAM,6,'',('127.0.0.1',80))]
+    with pytest.raises(WriteHttpError):validate_url('http://business.test/',resolve=True,resolver=hostile)
+    for url in ['http://127.0.0.1/','http://169.254.169.254/','http://[::ffff:127.0.0.1]/','http://a:b@business.test/',
+        'file:///etc/passwd','http://192.168.0.85/api/auth/me','http://business.test/?token=secret']:
+        with pytest.raises(WriteHttpError):validate_url(url)
+    with pytest.raises(WriteHttpError):normalize_config({'name':'x','url':'http://192.168.1.31/','query_path':'//evil/{request_id}'})
