+    StockWriteItem, StockWriteTarget, WriteError, resolve_item, control_plan)
+
+# These service probes intentionally use a fake employee authorizer. Separate
+# real-Cookie tests exercise the application and the worker checks the DB user.
+_dispatch_one=dispatch_one
+def dispatch_one(db,**kwargs):return _dispatch_one(db,authorize=lambda db,plan:True,**kwargs)
+
+
+def endpoint(name='first', **options):
+    return {'name':name,'url':'http://192.168.1.31:9988/'+name,
+        'write_mode':'overwrite','file_mode':'none','idempotent':False,**options}
+
+
+class Receiver:
+    def __init__(self):self.calls=[];self.fail=set();self.receipts={}
+    def __call__(self, config, body, *, query=False, file_path=None):
+        self.calls.append((config['name'],body['request_id'],query,body))
+        if config['name'] in self.fail:raise TimeoutError('synthetic')
+        return {'request_id':body['request_id'],'payload_hash':body['payload_hash'],'status':'succeeded'}
+
+
+def plan(db,run,targets=None,**options):
+    p=create_plan(db,source_kind='cover',run_id=run.id,selection={},result_mode='effective',
+        actor='tester',targets=targets or [endpoint()],**options)
+    db.commit();return p
+
+
+def test_no_request_before_confirmation_and_two_targets_are_independent(setup):
+    db,settings,sid=setup;run,_,_,_=ready(db,settings,sid);p=plan(db,run,[endpoint(),endpoint('second')])
+    recv=Receiver();assert not dispatch_one(db,settings=settings,send=recv)
+    confirm_plan(db,p.id,expected_revision=p.revision,actor='tester');db.commit()
+    recv.fail.add('first')
+    assert dispatch_one(db,settings=settings,send=recv)
+    assert dispatch_one(db,settings=settings,send=recv)
+    rows=db.scalars(select(StockWriteItem).order_by(StockWriteItem.id)).all()
+    assert sorted(r.status for r in rows)==['succeeded','uncertain']
+    assert len(recv.calls)==2
+
+
+def test_unknown_request_blocks_newer_version_and_manual_confirmation_requeues(setup):
+    from app.cover_regression import review_item
+    db,settings,sid=setup;run,item,a,_=ready(db,settings,sid);p=plan(db,run)
+    confirm_plan(db,p.id,expected_revision=p.revision,actor='tester');db.commit()
+    recv=Receiver();recv.fail.add('first');dispatch_one(db,settings=settings,send=recv)
+    old=db.scalar(select(StockWriteItem));original_id=old.request_id
+    review_item(db,item_id=item.id,attempt_id=a.id,expected_revision=0,verdict='adopt',reason='confirmed',actor='tester');db.commit()
+    scan_plan(db,p.id);db.commit()
+    assert not dispatch_one(db,settings=settings,send=recv)
+    assert len(recv.calls)==1 and old.request_id==original_id
+    resolve_item(db,old.id,expected_revision=old.revision,outcome='not_applied',evidence='receiver checked',actor='tester');db.commit()
+    recv.fail.clear();assert dispatch_one(db,settings=settings,send=recv)
+    assert db.get(StockWriteItem,old.id).status=='skipped'
+    assert len(recv.calls)==2 and recv.calls[-1][1]!=original_id
+
+
+def test_idempotent_retry_uses_same_request_and_pause_stops_new_posts(setup):
+    db,settings,sid=setup;run,_,_,_=ready(db,settings,sid);p=plan(db,run,[endpoint(idempotent=True)])
+    confirm_plan(db,p.id,expected_revision=p.revision,actor='tester');db.commit()
+    recv=Receiver();recv.fail.add('first');dispatch_one(db,settings=settings,send=recv)
+    row=db.scalar(select(StockWriteItem));rid=row.request_id;row.available_at='';db.commit()
+    control_plan(db,p.id,'pause',actor='tester');db.commit()
+    assert not dispatch_one(db,settings=settings,send=recv)
+    control_plan(db,p.id,'resume',actor='tester');db.commit();recv.fail.clear()
