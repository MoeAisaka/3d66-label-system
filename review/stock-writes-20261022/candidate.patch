+def test_no_redirect_and_acknowledgement_is_not_assumed_from_http_status(monkeypatch):
+    class Response:
+        status=302
+        def read(self,size):return b'{"status":"succeeded"}'
+    class Connection:
+        def __init__(self,*args,**kwargs):pass
+        def request(self,*args,**kwargs):pass
+        def getresponse(self):return Response()
+        def close(self):pass
+    monkeypatch.setattr('http.client.HTTPConnection',Connection)
+    monkeypatch.setattr('app.stock_write_http.validate_url',lambda *a,**k:('http://business.test/','business.test',80,['192.168.1.31']))
+    config={'url':'http://business.test/','timeout_seconds':1}
+    with pytest.raises(WriteHttpError):send(config,{'request_id':'fixed','payload_hash':'f'*64})
+
+
+def test_real_http_json_multipart_and_query_use_same_identity_without_cookies(monkeypatch,tmp_path):
+    import json,threading
+    from http.server import BaseHTTPRequestHandler,ThreadingHTTPServer
+    from app import stock_write_http as transport
+    seen=[];identity={'request_id':'same-fixed-request','payload_hash':'f'*64}
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self,*args):pass
+        def reply(self):
+            seen.append((self.command,self.path,dict(self.headers),self.rfile.read(int(self.headers.get('Content-Length','0')))))
+            data=json.dumps(identity|{'status':'succeeded'}).encode()
+            self.send_response(200);self.send_header('Content-Length',str(len(data)));self.end_headers();self.wfile.write(data)
+        do_POST=reply
+        do_GET=reply
+    server=ThreadingHTTPServer(('127.0.0.1',0),Handler)
+    thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()
+    actual_validate=transport.validate_url;actual_connect=socket.create_connection
+    def resolver(*args,**kwargs):return [(socket.AF_INET,socket.SOCK_STREAM,6,'',('192.168.1.31',server.server_port))]
+    monkeypatch.setattr(transport,'validate_url',lambda url,**kwargs:actual_validate(url,resolve=True,resolver=resolver))
+    connected=[]
+    def connect(address,**kwargs):
+        connected.append(address);assert address==('192.168.1.31',server.server_port)
+        return actual_connect(('127.0.0.1',server.server_port),**kwargs)
+    monkeypatch.setattr(socket,'create_connection',connect)
+    config={'url':f'http://receiver.test:{server.server_port}/receive','query_path':'/requests/{request_id}','timeout_seconds':2}
+    try:
+        assert send(config,identity)['status']=='succeeded'
+        file=tmp_path/'input.bin';file.write_bytes(b'synthetic-file-content')
+        assert send(config,identity,file_path=file)['status']=='succeeded'
+        assert send(config,identity,query=True)['status']=='succeeded'
+        assert [r[0] for r in seen]==['POST','POST','GET']
+        assert json.loads(seen[0][3])==identity
+        assert b'synthetic-file-content' in seen[1][3] and b'name="metadata"' in seen[1][3]
+        assert seen[2][1]=='/requests/same-fixed-request'
+        assert all(r[2]['Idempotency-Key']=='same-fixed-request' and 'Cookie' not in r[2] and 'Origin' not in r[2] for r in seen)
+        assert len(connected)==3
+    finally:server.shutdown();server.server_close();thread.join(timeout=5)
