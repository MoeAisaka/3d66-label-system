+                'attempts':r.attempts,'error_code':r.error_code,'human_revision':r.human_revision,
+                'result':doc.get('effective'),'human':doc.get('human'),'file':json.loads(r.file_json) if r.file_json else None,
+                'history':[{'operation':a.operation,'outcome':a.outcome,'actor':a.actor,'created_at':a.created_at,
+                    'detail':json.loads(a.detail_json)} for a in db.scalars(select(StockWriteAttempt).where(StockWriteAttempt.item_id==r.id).order_by(StockWriteAttempt.id))]})
+        return {**plan_payload(db,plan),'total':db.scalar(select(func.count()).select_from(q.subquery())),'items':items}
+
+    @router.post('/api/stock-writes/plans/{plan_id}/refresh')
+    def refresh(plan_id:str,user=Depends(current_user),db:Session=Depends(get_db)):
+        plan=plan_row(db,plan_id);writable(user,plan.category_key);enabled()
+        try:scan_plan(db,plan_id,force=True);db.commit();return plan_payload(db,plan)
+        except WriteError as exc:db.rollback();raise fail(exc) from exc
+
+    @router.post('/api/stock-writes/plans/{plan_id}/confirm')
+    def confirm(plan_id:str,payload:ConfirmRequest,user=Depends(current_user),db:Session=Depends(get_db)):
+        plan=plan_row(db,plan_id);writable(user,plan.category_key);enabled()
+        try:confirm_plan(db,plan_id,expected_revision=payload.expected_revision,actor=user.username);db.commit();return plan_payload(db,plan)
+        except WriteError as exc:db.rollback();raise fail(exc) from exc
+
+    @router.post('/api/stock-writes/plans/{plan_id}/control/{action}')
+    def control(plan_id:str,action:Literal['pause','resume','cancel'],user=Depends(current_user),db:Session=Depends(get_db)):
+        plan=plan_row(db,plan_id);writable(user,plan.category_key);enabled()
+        try:control_plan(db,plan_id,action,actor=user.username);db.commit();return plan_payload(db,plan)
+        except WriteError as exc:db.rollback();raise fail(exc) from exc
+
+    @router.post('/api/stock-writes/items/{item_id}/resolve')
+    def resolve(item_id:int,payload:ResolveRequest,user=Depends(current_user),db:Session=Depends(get_db)):
+        row=db.get(StockWriteItem,item_id)
+        if not row:raise HTTPException(404,'请求不存在')
+        plan=plan_row(db,db.get(StockWriteTarget,row.target_id).plan_id);writable(user,plan.category_key);enabled()
+        try:
+            resolve_item(db,item_id,expected_revision=payload.expected_revision,outcome=payload.outcome,evidence=payload.evidence,actor=user.username)
+            db.commit();return {'id':row.id,'status':row.status,'revision':row.revision}
+        except WriteError as exc:db.rollback();raise fail(exc) from exc
+
+    @router.get('/api/stock-writes/files/{token}')
+    def file(token:str,db:Session=Depends(get_db)):
+        if not re.fullmatch(r'[A-Za-z0-9_-]{43}',token):raise HTTPException(404,'文件链接无效')
+        row=db.scalar(select(StockWriteItem).where(StockWriteItem.file_token_hash==hashlib.sha256(token.encode()).hexdigest()))
+        if not row or not row.file_json:raise HTTPException(404,'文件链接无效')
+        if not row.file_expires_at or row.file_expires_at<=now():raise HTTPException(410,'文件链接已过期')
+        descriptor=json.loads(row.file_json)
+        try:path=artifact_path(get_settings(),descriptor)
+        except (WriteError,OSError):raise HTTPException(410,'文件不可用')
+        return FileResponse(path,filename=descriptor['sha256']+'.bin',media_type='application/octet-stream',headers={'Cache-Control':'private, no-store','Referrer-Policy':'no-referrer'})
+    return router
