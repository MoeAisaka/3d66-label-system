APP_HOST=127.0.0.1
APP_PORT=8080
SESSION_DAYS=7

# Windows/macOS 受控 start 脚本默认强制 127.0.0.1。局域网部署必须先完成
# 安全审批，再在启动脚本的当前进程中显式设置 APP_HOST=0.0.0.0。
#
# 可选：Windows 默认保存在当前用户 LocalAppData；macOS 默认保存在
# ~/Library/Application Support/3d66-label-system。
# 只填写代码仓库之外的绝对路径。
# DATA_DIR=D:\\3d66-label-data
# DATA_DIR=/Users/your-name/Library/Application Support/3d66-label-system
# NAS_MAPS_ROOT=/mnt/label-nas/maps
